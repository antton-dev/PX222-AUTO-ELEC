#include <stdint.h>

// Définitions des adresses (Exemple pour STM32F4xx)
#define RCC_BASE      0x40023800
#define GPIOA_BASE    0x40020000

// Registres pour l'horloge et la configuration
#define RCC_AHB1ENR   (*(volatile uint32_t *)(RCC_BASE + 0x30))
#define GPIOA_MODER   (*(volatile uint32_t *)(GPIOA_BASE + 0x00))

// Registres pour piloter la sortie (on/off)
#define GPIOA_BSRR    (*(volatile uint32_t *)(GPIOA_BASE + 0x18))

// --- FONCTIONS DE BASE ---

// Une fonction de délai simple (pas très précise mais suffisante)
void delay(volatile uint32_t count) {
    while (count--) {
        __asm__("nop"); // Ne rien faire pendant un cycle
    }
}

// Fonction pour allumer la LED (Pin PA5)
void led_on() {
    GPIOA_BSRR = (1 << 5); // Positionne le bit 5 (BS5) pour allumer
}

// Fonction pour éteindre la LED (Pin PA5)
void led_off() {
    GPIOA_BSRR = (1 << (5 + 16)); // Positionne le bit 21 (BR5) pour éteindre
}

// --- FONCTIONS MORSE ---

// Un "Point" (court)
void morse_dot() {
    led_on();
    delay(200000); // Court allumage
    led_off();
    delay(200000); // Courte pause entre les signes
}

// Un "Trait" (long)
void morse_dash() {
    led_on();
    delay(600000); // Allumage 3x plus long
    led_off();
    delay(200000); // Courte pause
}

// --- MAIN ---

int main(void) {
    // 1. Activer l'horloge pour le Port A
    RCC_AHB1ENR |= (1 << 0); // Bit 0 pour GPIOA

    // 2. Configurer PA5 en mode "Sortie"
    // On nettoie les bits 10 et 11, puis on met "01" (Output)
    GPIOA_MODER &= ~(3 << (5 * 2));
    GPIOA_MODER |= (1 << (5 * 2));

    while (1) {
        // --- Lettre S (... ) ---
        morse_dot();
        morse_dot();
        morse_dot();

        delay(400000); // Pause entre les lettres

        // --- Lettre O (---) ---
        morse_dash();
        morse_dash();
        morse_dash();

        delay(400000); // Pause entre les lettres

        // --- Lettre S (... ) ---
        morse_dot();
        morse_dot();
        morse_dot();

        // --- Grande pause avant de recommencer ---
        delay(2000000);
    }
}
